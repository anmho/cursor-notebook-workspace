{
  // Prefer this workspace's environment for Python and notebook discovery.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  // New Cursor terminals activate the same environment automatically.
  "python.terminal.activateEnvironment": true,
  // Kernel selection still happens explicitly from the notebook toolbar.
  "jupyter.askForKernelRestart": false,
  // Keep notebook line numbers visible while learning/debugging.
  "notebook.lineNumbers": "on"
}
