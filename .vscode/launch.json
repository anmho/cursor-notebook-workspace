{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Doctor",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/doctor.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {"PYTHONPATH": "${workspaceFolder}/src"}
    },
    {
      "name": "Train tiny model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train.py",
      "console": "integratedTerminal",
      "justMyCode": true,
      "args": ["--device", "auto", "--steps", "50"],
      "env": {"PYTHONPATH": "${workspaceFolder}/src"}
    }
  ]
}
