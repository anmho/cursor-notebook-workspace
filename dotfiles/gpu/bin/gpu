#!/usr/bin/env bash
set -euo pipefail

CONFIG_FILE="${ML_LAB_GPU_CONFIG:-$HOME/.config/ml-lab/gpu.env}"
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

GPU_HOST="${GPU_HOST:-}"
GPU_WORKSPACE="${GPU_WORKSPACE:-$HOME/Developer/ml-lab}"
GPU_PORT="${GPU_PORT:-8888}"

usage() {
  cat <<'EOF'
Usage: gpu {doctor|connect|tunnel|remote-doctor|up|down}

This helper never provisions or terminates a paid instance. Provision a box
through an approved provider, add its SSH host to ~/.ssh/config, then set
GPU_HOST in ~/.config/ml-lab/gpu.env.
EOF
}

require_host() {
  if [[ -z "$GPU_HOST" ]]; then
    echo "GPU_HOST is not configured in $CONFIG_FILE" >&2
    exit 2
  fi
}

case "${1:-help}" in
  doctor)
    printf 'provider=%s\n' "${GPU_PROVIDER:-manual}"
    printf 'host=%s\n' "${GPU_HOST:-<unset>}"
    printf 'workspace=%s\n' "$GPU_WORKSPACE"
    for command_name in ssh cursor uv; do
      printf '%-8s' "$command_name"
      command -v "$command_name" || true
    done
    if [[ -n "$GPU_HOST" ]]; then
      ssh -G "$GPU_HOST" >/dev/null && echo "ssh_config=ok" || echo "ssh_config=missing"
    fi
    ;;
  connect)
    require_host
    exec cursor --remote "ssh-remote+${GPU_HOST}" "$GPU_WORKSPACE"
    ;;
  tunnel)
    require_host
    echo "Forwarding local http://127.0.0.1:${GPU_PORT} to ${GPU_HOST}:${GPU_PORT}."
    exec ssh -N -L "${GPU_PORT}:127.0.0.1:${GPU_PORT}" "$GPU_HOST"
    ;;
  remote-doctor)
    require_host
    exec ssh "$GPU_HOST" "cd '$GPU_WORKSPACE' && printf 'host=%s\\n' \"\\$(hostname)\" && uname -srm && command -v uv || true && command -v python3 || true && command -v nvidia-smi || true && command -v nvcc || true && nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader 2>/dev/null || true && uv run python scripts/doctor.py 2>/dev/null || true"
    ;;
  up)
    echo "No provider provisioning is configured. This is intentional: GPU billing requires explicit provider approval." >&2
    echo "Provision manually, add the SSH host, then run: gpu doctor" >&2
    exit 2
    ;;
  down)
    echo "No provider termination is configured. Terminate the instance in the provider console or its approved CLI." >&2
    exit 2
    ;;
  *)
    usage
    exit 2
    ;;
esac
